<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DashyNMS.Agent.Shared.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup Condition="'$(SharedPackageVersion)' == ''">
    <ProjectReference Include="../../src/DashyNMS.Agent.Shared/DashyNMS.Agent.Shared.csproj" />
  </ItemGroup>

  <!--
    CI's Core compatibility job sets SharedPackageVersion to test the exact
    packed Shared binary, compiled against MCP's Core pin, while a consumer
    pins a different Core (DashyNMSCoreVersion). That is the combination a
    host such as mobile restores, so source builds alone would not prove it.
  -->
  <ItemGroup Condition="'$(SharedPackageVersion)' != ''">
    <PackageReference Include="DashyNMS.Agent.Shared" Version="[$(SharedPackageVersion)]" />
    <PackageReference Include="DashyNMS.Core" Version="[$(DashyNMSCoreVersion)]" />
  </ItemGroup>

</Project>
