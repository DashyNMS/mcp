<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>DashyNMS MCP</Product>
    <Company>DashyNMS</Company>
    <Authors>Thomas Pickup</Authors>
    <Copyright>Copyright (c) 2026 Thomas Pickup</Copyright>
    <PackageLicenseExpression Condition="'$(MSBuildProjectName)' != 'DashyNMS.Agent.Shared'">MIT</PackageLicenseExpression>
    <!-- The version being built towards: edge and nightly builds are
         2.0.0-edge.N and 2.0.0-nightly.N, and a release is 2.0.0. -->
    <Version>2.0.0</Version>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <!--
      DesktopNMS.Core lives in DashyNMS/core and comes in as the DashyNMS.Core
      package from GitHub Packages (see nuget.config), pinned to a nightly or edge
      package of Core's main between Core releases. The standalone MCP server
      uses the same pin as Desktop. Shared has its own minimum so hosts can
      keep using their current Core package. Set DASHYNMS_LOCAL_CORE to a
      Core checkout to build against that instead.
    -->
    <DashyNMSCoreVersion>2.0.0-nightly.5</DashyNMSCoreVersion>
    <DashyNMSSharedCoreVersion>2.0.0-nightly.3</DashyNMSSharedCoreVersion>
  </PropertyGroup>

</Project>
