<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>DashyNMS MCP</Product>
    <Company>DashyNMS</Company>
    <Version>1.1.0</Version>
    <NeutralLanguage>en-GB</NeutralLanguage>
    <!--
      DesktopNMS.Core lives in DashyNMS/core and comes in as the DashyNMS.Core
      package from GitHub Packages (see nuget.config), pinned to a development
      build of core's main (x.y.z-ci.N) between Core releases - the same Core
      the desktop app pins. Set DASHYNMS_LOCAL_CORE to a checkout of
      DashyNMS/core to build against that instead.
    -->
    <DashyNMSCoreVersion>2.0.0-ci.34</DashyNMSCoreVersion>
  </PropertyGroup>

</Project>
