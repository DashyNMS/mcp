<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tool layer: task-shaped read tools over Core, plus redaction and
    result caps. Kept apart from the host on purpose - it is the part that
    later moves into the desktop repo next to Core, so the DashyNMS mobile
    chat tab can run the same tools without a server.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DashyNMS.Agent</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" Version="2.3.0" />
  </ItemGroup>

  <!-- DesktopNMS.Core - see Directory.Build.props. -->
  <ItemGroup Condition="'$(DASHYNMS_LOCAL_CORE)' == ''">
    <PackageReference Include="DashyNMS.Core" Version="$(DashyNMSCoreVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(DASHYNMS_LOCAL_CORE)' != ''">
    <ProjectReference Include="$(DASHYNMS_LOCAL_CORE)/src/DesktopNMS.Core/DesktopNMS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DashyNMS.Agent.Tests" />
  </ItemGroup>

</Project>
