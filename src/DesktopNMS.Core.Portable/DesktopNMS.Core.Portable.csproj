<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop app's DesktopNMS.Core, compiled for net10.0 so the server runs
    on Linux (in Docker) as well as Windows. Nothing is copied: the sources
    come straight from the external/desktop submodule, so a fix there reaches
    the server on the next submodule bump. Same approach as DashyNMS/mobile,
    so nothing is ever built inside the submodule's own folders.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DesktopNMS.Core</RootNamespace>
    <!-- Same assembly name as on desktop, so InternalsVisibleTo and any
         serialised type names match. -->
    <AssemblyName>DesktopNMS.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Upstream code, built as upstream builds it: don't fail on warnings
         the desktop repo doesn't treat as errors. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(DesktopRoot)src/DesktopNMS.Core/**/*.cs"
             Exclude="$(DesktopRoot)src/DesktopNMS.Core/bin/**;$(DesktopRoot)src/DesktopNMS.Core/obj/**"
             LinkBase="DesktopNMS.Core" />
  </ItemGroup>

  <!-- Core's open-source licence texts, embedded under the same names Core's
       own csproj gives them, so OpenSourceNotices.ReadLicence finds them. -->
  <ItemGroup>
    <EmbeddedResource Include="$(DesktopRoot)src/DesktopNMS.Core/Licences/Texts/*.txt"
                      LogicalName="DesktopNMS.Core.Licences.%(Filename)%(Extension)"
                      LinkBase="DesktopNMS.Core/Licences/Texts" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DashyNMS.Agent" />
    <InternalsVisibleTo Include="DashyNMS.Agent.Tests" />
  </ItemGroup>

</Project>
