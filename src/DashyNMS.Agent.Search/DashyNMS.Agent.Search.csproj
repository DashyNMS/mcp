<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>DashyNMS.Agent.Search</PackageId>
    <Authors>Thomas Pickup</Authors>
    <Copyright>Copyright (c) 2026 Thomas Pickup</Copyright>
    <SearchBuildVersion Condition="'$(SearchBuildVersion)' == ''">0.1.0-dev</SearchBuildVersion>
    <Version>$(SearchBuildVersion)</Version>
    <PackageVersion>$(SearchBuildVersion)</PackageVersion>
    <PackageProjectUrl>https://github.com/DashyNMS/mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DashyNMS/mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>DashyNMS.Agent</RootNamespace>
    <Description>Typed read-only device search over host-owned LibreNMS clients, without MCP.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(DASHYNMS_LOCAL_CORE)' == ''">
    <PackageReference Include="DashyNMS.Core" Version="$(DashyNMSCoreVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(DASHYNMS_LOCAL_CORE)' != ''">
    <ProjectReference Include="$(DASHYNMS_LOCAL_CORE)/src/DesktopNMS.Core/DesktopNMS.Core.csproj" />
  </ItemGroup>
  <Target Name="RejectLocalCorePackage" BeforeTargets="Pack" Condition="'$(DASHYNMS_LOCAL_CORE)' != ''">
    <Error Text="Search packages must use the pinned DashyNMS.Core package, not a local checkout." />
  </Target>
  <ItemGroup>
    <None Include="../../NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DashyNMS.Agent" />
    <InternalsVisibleTo Include="DashyNMS.Agent.Tests" />
    <InternalsVisibleTo Include="DashyNMS.Agent.Search.Tests" />
  </ItemGroup>
</Project>
