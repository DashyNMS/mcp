<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>DashyNMS.Agent.Shared</PackageId>
    <Authors>Thomas Pickup</Authors>
    <Copyright>Copyright (c) 2026 Thomas Pickup</Copyright>
    <SharedBuildVersion Condition="'$(SharedBuildVersion)' == ''">2.0.0-dev</SharedBuildVersion>
    <Version>$(SharedBuildVersion)</Version>
    <PackageVersion>$(SharedBuildVersion)</PackageVersion>
    <PackageProjectUrl>https://github.com/DashyNMS/mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DashyNMS/mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>DashyNMS.Agent</RootNamespace>
    <Description>Typed read-only LibreNMS operations shared by DashyNMS hosts over host-owned clients, without MCP.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(DASHYNMS_LOCAL_CORE)' == ''">
    <PackageReference Include="DashyNMS.Core" Version="$(DashyNMSSharedCoreVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(DASHYNMS_LOCAL_CORE)' != ''">
    <ProjectReference Include="$(DASHYNMS_LOCAL_CORE)/src/DesktopNMS.Core/DesktopNMS.Core.csproj" />
  </ItemGroup>
  <Target Name="RejectLocalCorePackage" BeforeTargets="Pack" Condition="'$(DASHYNMS_LOCAL_CORE)' != ''">
    <Error Text="Shared packages must use the pinned DashyNMS.Core package, not a local checkout." />
  </Target>
  <ItemGroup>
    <None Include="../../NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!--
    The user guides the help tool reads (#164): this repository's own, and the
    copies scripts/update-guides.py takes of Desktop's and Mobile's. Text only.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Help/Guides/desktop/**/*.md" LogicalName="DashyNMS.Agent.Help/desktop/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help/Guides/mobile/**/*.md" LogicalName="DashyNMS.Agent.Help/mobile/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/guide/**/*.md" LogicalName="DashyNMS.Agent.Help/mcp/docs/guide/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Help/Guides/guides.json" LogicalName="DashyNMS.Agent.Help/guides.json" />
  </ItemGroup>
  <!-- A build without one would ship a help tool that knows nothing about it. -->
  <Target Name="RequireGuides" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('../../docs/guide/README.md') Or !Exists('Help/Guides/desktop/docs/guide/README.md') Or !Exists('Help/Guides/mobile/docs/guide/README.md')" Text="A user guide the help tool reads is missing. See scripts/update-guides.py." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="DashyNMS.Agent" />
    <InternalsVisibleTo Include="DashyNMS.Agent.Tests" />
    <InternalsVisibleTo Include="DashyNMS.Agent.Shared.Tests" />
  </ItemGroup>
</Project>
